# ============================================================
# VirtualCorp - Versions fixades dels sistemes operatius
# ============================================================
#
# Fitxer VERSIONAT. Sintaxi CLAU=valor (sense cometes ni espais) perquè
# el puguin llegir tant GNU Make (include) com Bash (source).
#
# No es descarrega mai "la darrera versió": canviar una versió implica
# editar aquest fitxer en una branca específica, provar-ho i fusionar-ho
# (vegeu docs/versions.md).
#
# Origen dels hashos (verificat el 2026-11-18):
#   - Debian: SHA256SUMS signat amb la "Debian CD signing key"
#     (empremta DF9B9C49EAA9298432589D76DA87E80D6294BE9B), signatura correcta.
#   - Proxmox VE: SHA256SUMS oficial publicat a enterprise.proxmox.com/iso/.

# ------------------------------------------------------------
# Debian 13 (Trixie) - netinst amd64
# ------------------------------------------------------------
DEBIAN_VERSION=13.7.0
DEBIAN_ISO_FILENAME=debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_URL=https://cdimage.debian.org/debian-cd/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_MIRROR_URL=
DEBIAN_ISO_SHA256=a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355

# ------------------------------------------------------------
# Proxmox VE 9.2-1
# ------------------------------------------------------------
# El mirror NO és una altra versió: és el mateix fitxer servit per un altre
# domini oficial. El hash garanteix que és idèntic. S'utilitza només si la
# URL principal falla (p. ex. el certificat TLS de download.proxmox.com no
# coincidia amb el nom del servidor el 2026-11-18).
PVE_VERSION=9.2-1
PVE_ISO_FILENAME=proxmox-ve_9.2-1.iso
PVE_ISO_URL=https://download.proxmox.com/iso/proxmox-ve_9.2-1.iso
PVE_ISO_MIRROR_URL=https://enterprise.proxmox.com/iso/proxmox-ve_9.2-1.iso
PVE_ISO_SHA256=4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c
