# GNU Make assignments, loaded by the root Makefile.
# Override only what differs in your local environment.

PROJECT_ROOT ?= $(CURDIR)
ARTIFACTS_DIR ?= $(PROJECT_ROOT)/artifacts
CONFIGS_DIR ?= $(PROJECT_ROOT)/configs
SSH_PUBLIC_KEY_DIR ?= $(CONFIGS_DIR)/ssh
SSH_PRIVATE_KEY_DIR ?= $(HOME)/.ssh

ROUTEROS_VERSION ?= 7.21.4
ROUTEROS_VDI_FILENAME ?= chr-$(ROUTEROS_VERSION).vdi
ROUTEROS_VDI_PATH ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_VDI_FILENAME)
ROUTEROS_BOX_NAME ?= routeros-base
ROUTEROS_BOX_FILE ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_BOX_NAME).box

VBOX_ROOT_GROUP ?= /VirtualCorp
VM_ROUTERS_GROUP ?= $(VBOX_ROOT_GROUP)/Routers
VM_TEMPLATES_GROUP ?= $(VBOX_ROOT_GROUP)/templates
# Set this only when VirtualBox is installed outside PATH or under another name.
# VBOXMANAGE_BIN ?= /path/to/VBoxManage

# ------------------------------------------------------------
# Activitat 2: templates Debian, equips i Proxmox VE
# ------------------------------------------------------------
# Les versions de les ISO NO van aquí: són a configs/versions.env (versionat).
ISO_DIR ?= $(ARTIFACTS_DIR)/images/iso
BUILD_DIR ?= $(ARTIFACTS_DIR)/build
VM_SERVERS_GROUP ?= $(VBOX_ROOT_GROUP)/Servers
VM_PRINTERS_GROUP ?= $(VBOX_ROOT_GROUP)/Printers
VM_DESKTOPS_GROUP ?= $(VBOX_ROOT_GROUP)/Desktops
VCORP_DOMAIN ?= del25.virtualcorp.internal

# Recursos de pve01 (ajusteu-los a la capacitat de l'amfitrió).
PVE_MEMORY ?= 8192
PVE_CPUS ?= 4
PVE_DISK_MB ?= 65536

# Contrasenyes LOCALS (aquest fitxer .env està ignorat per Git).
# Només es fan servir per generar hashos SHA-512 durant la instal·lació;
# mai s'escriuen en clar als fitxers del repositori.
#SYSADMIN_PASSWORD ?= canvieu-me
#PVE_ROOT_PASSWORD ?= canvieu-me
